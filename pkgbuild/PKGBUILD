pkgname=needful
pkgver=0.6.0
pkgrel=1
pkgdesc='Routine tasks, most needful first'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('tailscale: serve Needful on your tailnet')
makedepends=('gcc' 'make' 'cargo')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/needful "$pkgdir/usr/bin/needful"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/needful.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/needful.svg"
  install -Dm644 "$startdir/needful.desktop" "$pkgdir/usr/share/applications/needful.desktop"
}
