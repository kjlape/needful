pkgname=needful
pkgver=0.14.0
pkgrel=1
pkgdesc='Routine tasks, most needful first'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('tailscale: serve Needful on your tailnet')
makedepends=('gcc' 'make' 'cargo')

# bin/install builds this checkout. bin/release-arch fills in _tarball and
# _sha256 with an export of the tagged commit, so a clean chroot, which can't
# see this checkout, builds exactly what was tagged.
_tarball=
_sha256=
source=(${_tarball:+"$_tarball"})
sha256sums=(${_sha256:+"$_sha256"})

_tree() {
  if [ -n "$_tarball" ]; then
    printf '%s\n' "$srcdir/$pkgname-$pkgver"
  else
    printf '%s\n' "$startdir/.."
  fi
}

build() {
  cd "$(_tree)"
  ./bin/build
}

package() {
  cd "$(_tree)"
  install -Dm755 build/needful "$pkgdir/usr/bin/needful"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/needful.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/needful.svg"
  install -Dm644 pkgbuild/needful.desktop "$pkgdir/usr/share/applications/needful.desktop"
}
