#!/bin/sh
# Publishes Needful as a signed pacman repository on the latest GitHub
# release, with its setup on GitHub Pages, so Arch machines that add it get
# new releases with pacman -Syu.
#
#   bin/release-arch            Tag v<version> here, build the package in a
#                               clean chroot, sign it and its one-package
#                               database into build/release-assets/v<version>,
#                               and update the setup in build/pages, a checkout
#                               of the gh-pages branch. Nothing leaves the
#                               machine.
#   bin/release-arch --publish  Also push the tag, upload the repository to
#                               the tag's GitHub release and mark it Latest,
#                               push gh-pages, and turn on GitHub Pages.
#
# Runs on x86_64 Arch, on a clean commit whose VERSION (in needful.pro) is
# newer than what's published. Needs devtools, for the clean chroot (it asks
# for sudo), and NEEDFUL_GPG_KEY, the key that signs the packages and the
# repository; see docs/releasing-for-linux.md.
#
# NEEDFUL_NO_CHROOT=1 builds with plain makepkg instead, to rehearse without
# devtools. Such a build can't be published.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. "$ROOT/bin/pages.sh"
REPO_NAME=needful
# The package inside the repository. It was needful up to 0.15.0; its
# replaces=() moves machines over on their next pacman -Syu.
PKG_NAME=lape-needful

parse_publish "$@"
command -v repo-add >/dev/null && command -v vercmp >/dev/null || die "this runs on Arch Linux, with pacman."
[ "$(uname -m)" = x86_64 ] || die "this builds x86_64 packages, on an x86_64 machine."
CHROOT=1
if [ "${NEEDFUL_NO_CHROOT:-}" = 1 ]; then
    CHROOT=0
    [ "$PUBLISH" = 0 ] || die "a build made without the clean chroot can't be published."
else
    command -v extra-x86_64-build >/dev/null || die "extra-x86_64-build is missing. sudo pacman -S devtools"
fi
KEY="${NEEDFUL_GPG_KEY:-}"
[ -n "$KEY" ] || die "set NEEDFUL_GPG_KEY to the signing key's fingerprint. See docs/releasing-for-linux.md."
gpg --list-secret-keys "$KEY" >/dev/null 2>&1 || die "gpg has no secret key $KEY."
FINGERPRINT="$(gpg --with-colons --fingerprint "$KEY" | awk -F: '/^fpr:/ { print $10; exit }')"
cd "$ROOT"
release_version
PKGBUILD_TEXT="$(git show "$SOURCE:pkgbuild/PKGBUILD")"
PKGREL="$(printf '%s\n' "$PKGBUILD_TEXT" | sed -n 's/^pkgrel=//p')"
[ "$(printf '%s\n' "$PKGBUILD_TEXT" | sed -n 's/^pkgver=//p')" = "$VERSION" ] ||
    die "pkgbuild/PKGBUILD's pkgver isn't $VERSION, the VERSION in needful.pro."
FULL="$VERSION-$PKGREL"
pages_checkout

# The repository is the newest package and a database of just it, both
# signed, on the release marked Latest: pacman's Server is releases/latest/
# download, which GitHub redirects to that release's files. Older releases
# keep theirs. arch/ on gh-pages holds the setup and the version last
# published.
REPO="$ASSETS"
mkdir -p "$REPO" "$PAGES/arch"
# Before releases held it, the repository was arch/x86_64 on gh-pages.
rm -rf "$PAGES/arch/x86_64"
published="$(cat "$PAGES/arch/version" 2>/dev/null || true)"
if [ -n "$published" ]; then
    [ "$REMOTE_PAGES" = 1 ] && [ "$published" = "$FULL" ] && pages_finish "Needful $FULL for Arch"
    # One made here by a run without --publish, and not on origin, is made again.
    if [ "$REMOTE_PAGES" = 1 ] || [ "$published" != "$FULL" ]; then
        [ "$(vercmp "$FULL" "$published")" -gt 0 ] ||
            die "$FULL isn't newer than the published $published. Bump the version first."
    fi
fi

# The chroot can't see this checkout, so it builds an export of the release's
# commit, named in that commit's PKGBUILD with its hash.
STAGE="$ROOT/build/arch"
rm -rf "$STAGE"
mkdir -p "$STAGE/out"
TARBALL="$PKG_NAME-$VERSION.tar.gz"
git archive --format=tar.gz --prefix="$PKG_NAME-$VERSION/" -o "$STAGE/$TARBALL" "$SOURCE"
SHA256="$(sha256sum "$STAGE/$TARBALL" | cut -d' ' -f1)"
printf '%s\n' "$PKGBUILD_TEXT" |
    sed -e "s/^_tarball=\$/_tarball=$TARBALL/" -e "s/^_sha256=\$/_sha256=$SHA256/" >"$STAGE/PKGBUILD"
grep -q "^_tarball=$TARBALL\$" "$STAGE/PKGBUILD" && grep -q "^_sha256=$SHA256\$" "$STAGE/PKGBUILD" ||
    die "couldn't fill in _tarball and _sha256 in pkgbuild/PKGBUILD."

cd "$STAGE"
export PKGDEST="$STAGE/out"
if [ "$CHROOT" = 1 ]; then
    extra-x86_64-build
else
    makepkg -f
fi
PACKAGE_PATH="$(makepkg --packagelist | grep -v -- "-debug-" | head -1)"
PACKAGE="$(basename "$PACKAGE_PATH")"
# makechrootpkg may leave it next to the PKGBUILD instead.
[ -f "$PACKAGE_PATH" ] || PACKAGE_PATH="$STAGE/$PACKAGE"
[ -f "$PACKAGE_PATH" ] || die "the build made no $PACKAGE."
cd "$ROOT"

# A fresh database each time, since each release carries its own.
rm -f "$REPO/$REPO_NAME"-*.pkg.tar.* "$REPO/$PKG_NAME"-*.pkg.tar.* "$REPO/$REPO_NAME".db* "$REPO/$REPO_NAME".files*
cp "$PACKAGE_PATH" "$REPO/$PACKAGE"
gpg --batch --yes --local-user "$KEY" --detach-sign --output "$REPO/$PACKAGE.sig" "$REPO/$PACKAGE"
repo-add --quiet --sign --key "$KEY" "$REPO/$REPO_NAME.db.tar.gz" "$REPO/$PACKAGE"
# repo-add makes needful.db a symlink to needful.db.tar.gz; pacman fetches
# only the short names, so those become the files and the long ones go.
for link in "$REPO_NAME.db" "$REPO_NAME.db.sig" "$REPO_NAME.files" "$REPO_NAME.files.sig"; do
    if [ -L "$REPO/$link" ]; then
        target="$(readlink "$REPO/$link")"
        rm "$REPO/$link"
        mv "$REPO/$target" "$REPO/$link"
    fi
done
# The release's files, as the arguments from here on.
set -- "$REPO/$PACKAGE" "$REPO/$PACKAGE.sig"
for name in "$REPO_NAME.db" "$REPO_NAME.db.sig" "$REPO_NAME.files" "$REPO_NAME.files.sig"; do
    [ -f "$REPO/$name" ] || die "repo-add made no $name."
    set -- "$@" "$REPO/$name"
done

gpg --export --armor "$KEY" >"$PAGES/arch/$REPO_NAME.gpg"
cat >"$PAGES/arch/install.html" <<EOF
<h2>Arch Linux</h2>
<p>Trust the key that signs the repository, once. Its fingerprint is
<code>$FINGERPRINT</code>.</p>
<pre>curl -fsSLO $PAGES_URL/arch/$REPO_NAME.gpg
sudo pacman-key --add $REPO_NAME.gpg
sudo pacman-key --lsign-key $FINGERPRINT</pre>
<p>Add the repository to <code>/etc/pacman.conf</code>:</p>
<pre>[$REPO_NAME]
SigLevel = Required
Server = $RELEASES_URL/latest/download</pre>
<p>Then install Needful $VERSION:</p>
<pre>sudo pacman -Syu $PKG_NAME</pre>
<p>New releases arrive with <code>pacman -Syu</code>. For x86_64.</p>
<p>A <code>Server</code> line ending in <code>/arch/\$arch</code> is from before
the repository moved to GitHub releases; replace it with this one.</p>
EOF
printf '%s\n' "$FULL" >"$PAGES/arch/version"

pages_commit "Publish Needful $TAG for Arch"
echo "Put $PACKAGE and its database in $REPO and tagged $TAG."
if [ "$PUBLISH" = 0 ]; then
    echo "Nothing was pushed. Publish with: bin/release-arch --publish"
    exit 0
fi
RELEASE_LATEST=1
pages_publish "Needful $FULL for Arch" "$@"
echo "Published. Machines with the repository get $FULL with: sudo pacman -Syu"
echo "Setup for new ones is at $PAGES_URL/"
